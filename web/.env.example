# Copy to .env and fill in. Never commit .env.

# MySQL / MariaDB. The app only uses tables with the cw_ prefix, so it can share an existing database.
# Create the database as utf8mb4, e.g.:
#   CREATE DATABASE cw_dev CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
DATABASE_URL=mysql://user:password@localhost:3306/cw_dev
DB_POOL_SIZE=5

# Public address of the site (no trailing slash) and a long random secret:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

# Optional: sign in with Google / GitHub. A button appears only when both values are set.
# Google: https://console.cloud.google.com/apis/credentials
#   redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# GitHub: https://github.com/settings/developers -> OAuth Apps
#   callback URL: <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: shared water conversion, litres per million tokens (defaults = woda.json)
# WATER_L_PER_MTOK_IN=20
# WATER_L_PER_MTOK_CACHE_WRITE=20
# WATER_L_PER_MTOK_CACHE_READ=2
# WATER_L_PER_MTOK_OUT=100
